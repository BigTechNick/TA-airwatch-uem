# Readable by everyone, changed by admins. Search-time settings are shared so the
# events and the collector's logs parse in any app.
[]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[props]
export = system

[transforms]
export = system

[lookups]
export = system

[views]
access = read : [ * ], write : [ admin, sc_admin ]

# OAuth client secrets (credential store): admins only.
[passwords]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
